# Port 8446 for clients that ask for the public domain by name -- ATAK's
# "Quick Connect" with the domain typed in. Those clients verify the server
# certificate against the public CAs AND against the hostname they typed, so
# this block presents the Let's Encrypt certificate for DOMAIN_NAME.
#
# Everything else on 8446 (VPN and bare-IP users, which send no SNI) falls
# through to the default block in raven_certificate_enrollment, which keeps
# Raven's own internal-CA certificate. See the comment at the top of that file.
#
# Written by the installers (install.sh, the .deb postinst, the RPM's
# configure.sh) only AFTER certbot has a certificate for the domain, and
# removed again before every certbot run, so that certbot never mistakes this
# block for the domain's web-UI server block. certbot does not manage this
# file: the LE paths below are symlinks certbot repoints on renewal, and the
# reload that picks the new cert up comes from certbot's nginx installer plus
# /etc/letsencrypt/renewal-hooks/deploy/raven-nginx-reload.
#
# DOMAIN_NAME is substituted at install time, not package-build time: it is
# the only machine-specific value in the file.
server {

    root /var/www/html/raven;
    index index.html index.htm index.nginx-debian.html;

    server_name DOMAIN_NAME;

    location /Marti/api/tls {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    location /oauth {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $host:443;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Ssl-Cert $ssl_client_escaped_cert;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # listen [::]:8446 ssl ipv6only=on;
    listen 8446 ssl;
    ssl_certificate /etc/letsencrypt/live/DOMAIN_NAME/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/DOMAIN_NAME/privkey.pem;
}
