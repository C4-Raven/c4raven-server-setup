#!/bin/bash
# postinst for the c4raven-server .deb.
#
# Mirrors c4raven-server-setup/install.sh step for step -- see that script
# for the curl|bash equivalent this replaces. Every step keeps install.sh's
# "check before creating" idempotency, so this runs safely both on a fresh
# install and on every `apt upgrade` to a newer c4raven-server package.
set -euo pipefail

. /usr/share/debconf/confmodule

APP_USER="raven"
APP_HOME="/opt/raven"
DATA_DIR="$APP_HOME/data"
DB_NAME="raven"
WEBROOT="/var/www/html/raven"
PKGDATA="/usr/share/c4raven-server"
# Present only in the offline build (build-offline.sh): prebuilt backend
# wheels, the built UI, mediamtx and the ATAK plugin. When it exists, every
# step below installs from it instead of reaching out to GitHub/PyPI/npm.
OFFLINE_DIR="$PKGDATA/offline"
FLASK_ENV="FLASK_APP=raven.app RAVEN_DATA_FOLDER='$DATA_DIR'"

# runuser (util-linux, essential) rather than sudo: we're already root here
# and sudo isn't guaranteed to exist on a minimal image.
run_as_app() {
  runuser -u "$APP_USER" -- bash -lc "$1"
}

offline() {
  [ -d "$OFFLINE_DIR" ]
}

# Run a command from the backend's environment as the app user: the Poetry
# venv of the source checkout (online build) or the plain venv (offline).
# $1 is one shell word list, e.g. "flask raven create-ca".
raven_exec() {
  if offline; then
    run_as_app "cd '$DATA_DIR' && $FLASK_ENV '$APP_HOME/venv/bin/'$1"
  else
    run_as_app "cd '$APP_HOME/c4raven-server' && $FLASK_ENV poetry run $1"
  fi
}

node_ok() {
  command -v node >/dev/null 2>&1 && node -e '
    const [a, b] = process.versions.node.split(".").map(Number);
    process.exit((a === 20 && b >= 19) || (a === 22 && b >= 12) || a >= 23 ? 0 : 1);'
}

case "$1" in
  configure)
    # libc-bin's ldconfig trigger is deferred to the END of the apt run, so
    # a libpq5 unpacked in this same transaction is not in ld.so.cache yet.
    # psycopg (pure-python build) finds libpq via ctypes.util.find_library,
    # which reads that cache -- without this, the first `flask raven` call
    # on a fresh box dies with "libpq library not found".
    ldconfig

    echo "Setting up the dedicated '$APP_USER' account..."
    if ! id "$APP_USER" &>/dev/null; then
      useradd --system --create-home --home-dir "$APP_HOME" --shell /bin/bash "$APP_USER"
      chmod 750 "$APP_HOME"
    fi
    run_as_app "mkdir -p '$DATA_DIR/logs'"

    # -------------------------------------------------------------------
    # Backend: clone (first install only) + checkout the exact commit this
    # package version was built against, then install. This is a real
    # improvement over install.sh/update.sh, which always float to
    # origin/main -- installing or upgrading this .deb now installs a
    # specific, reproducible version instead.
    # -------------------------------------------------------------------
    echo "Installing the Raven backend..."
    if offline; then
      # Fresh venv per install, then an atomic symlink swap: the running
      # services keep their old venv until they're restarted further down,
      # and a failed install leaves the working one in place. The old venv
      # is only deleted once the new services are up (end of this script).
      PYTAG=$(python3 -c 'import sys; print("cp%d%d" % sys.version_info[:2])')
      WHEELS="$OFFLINE_DIR/wheelhouse"
      if [ ! -d "$WHEELS/$PYTAG" ]; then
        echo "This package bundles backend wheels for: $(cd "$WHEELS" && ls -d cp* | tr '\n' ' ')" >&2
        echo "but this system's python3 is $PYTAG. Use the offline bundle built for this Ubuntu release." >&2
        exit 1
      fi
      NEW_VENV="$APP_HOME/venvs/$(cat "$OFFLINE_DIR/VERSION")-$(date +%Y%m%d%H%M%S)"
      run_as_app "mkdir -p '$APP_HOME/venvs' && python3 -m venv '$NEW_VENV'"
      PIP="PIP_CONFIG_FILE=/dev/null PIP_DISABLE_PIP_VERSION_CHECK=1 '$NEW_VENV/bin/pip' install --quiet --no-index"
      run_as_app "$PIP --find-links '$WHEELS/$PYTAG' --find-links '$WHEELS/common' -r '$OFFLINE_DIR/requirements.txt'"
      run_as_app "$PIP --no-deps '$WHEELS'/common/raven-*.whl"
      ln -sfn "$NEW_VENV" "$APP_HOME/venv.new"
      chown -h "$APP_USER:$APP_USER" "$APP_HOME/venv.new"
      mv -T "$APP_HOME/venv.new" "$APP_HOME/venv"
    else
      if [ ! -d "$APP_HOME/c4raven-server" ]; then
        run_as_app "git clone https://github.com/C4-Raven/c4raven-server.git '$APP_HOME/c4raven-server'"
      fi
      if [ -f "$PKGDATA/SERVER_SHA" ]; then
        SERVER_SHA=$(cat "$PKGDATA/SERVER_SHA")
        # raven/__init__.py is a version stamp poetry-dynamic-versioning rewrites
        # on every install; discard it first or git refuses to switch commits.
        run_as_app "cd '$APP_HOME/c4raven-server' && git checkout -- raven/__init__.py 2>/dev/null; git fetch origin && git checkout '$SERVER_SHA'"
      fi

      if ! run_as_app "test -x '$APP_HOME/.local/bin/poetry'"; then
        run_as_app "curl -sSL https://install.python-poetry.org | python3 -"
      fi
      run_as_app "poetry config virtualenvs.in-project true"
      run_as_app "cd '$APP_HOME/c4raven-server' && poetry install"
    fi

    raven_exec "flask raven generate-config"
    echo "Raven backend installed."

    # -------------------------------------------------------------------
    # PostgreSQL
    # -------------------------------------------------------------------
    echo "Setting up PostgreSQL..."
    # postgresql-common normally leaves the cluster running, but not when a
    # policy-rc.d forbids it or an admin stopped it; everything below needs it.
    if [ -d /run/systemd/system ]; then
      systemctl enable postgresql >/dev/null 2>&1 || true
      systemctl start postgresql || true
    fi
    for _ in $(seq 30); do pg_isready -q && break; sleep 1; done
    DB_USER_EXISTS=$(su postgres -c "psql -tXAc \"SELECT 1 FROM pg_roles WHERE rolname='$DB_NAME'\"")
    if [ "$DB_USER_EXISTS" != 1 ]; then
      # Hex only: this goes raw into a URI, where `%` would be percent-decoded
      # by SQLAlchemy/libpq. (Not `tr ... | head -c`: under pipefail, head
      # closing the pipe kills tr with SIGPIPE and this script with it.)
      POSTGRESQL_PASSWORD=$(openssl rand -hex 16)
      su postgres -c "psql -c \"create role $DB_NAME with login password '${POSTGRESQL_PASSWORD}';\""
      DB_URI="postgresql+psycopg://$DB_NAME:${POSTGRESQL_PASSWORD}@127.0.0.1/$DB_NAME"
      run_as_app "python3 - '$DB_URI' << 'PYEOF'
import sys, yaml
uri = sys.argv[1]
path = '$DATA_DIR/config.yml'
with open(path) as f:
    conf = yaml.safe_load(f)
conf['SQLALCHEMY_DATABASE_URI'] = uri
with open(path, 'w') as f:
    yaml.safe_dump(conf, f)
PYEOF"
    else
      # Already exists (a previous install or upgrade) -- config.yml
      # already has the right SQLALCHEMY_DATABASE_URI from that run, and
      # we don't have the password to rebuild it here.
      DB_URI=$(run_as_app "python3 -c \"import yaml; print(yaml.safe_load(open('$DATA_DIR/config.yml'))['SQLALCHEMY_DATABASE_URI'])\"")
    fi

    DB_EXISTS=$(su postgres -c "psql -XtAc \"SELECT 1 FROM pg_database WHERE datname='$DB_NAME'\"")
    if [ "$DB_EXISTS" != 1 ]; then
      su postgres -c "psql -c 'create database $DB_NAME;'"
    fi
    su postgres -c "psql -c 'GRANT ALL PRIVILEGES ON DATABASE \"$DB_NAME\" TO $DB_NAME;'"
    su postgres -c "psql -d $DB_NAME -c 'GRANT ALL ON SCHEMA public TO $DB_NAME;'"
    su postgres -c "psql -d $DB_NAME -c 'CREATE EXTENSION IF NOT EXISTS postgis'"
    echo "Database ready."
    # Migrations run automatically inside the app itself on every startup
    # (see init_extensions() in raven/app.py) -- no separate `flask db
    # upgrade` step needed or wanted here.

    # -------------------------------------------------------------------
    # Cloudflare Turnstile (from debconf)
    # -------------------------------------------------------------------
    db_get c4raven-server/turnstile-enable
    if [ "$RET" = "true" ]; then
      db_get c4raven-server/turnstile-site-key
      TURNSTILE_SITE_KEY="$RET"
      db_get c4raven-server/turnstile-secret-key
      TURNSTILE_SECRET_KEY="$RET"
      run_as_app "python3 - '$TURNSTILE_SITE_KEY' '$TURNSTILE_SECRET_KEY' << 'PYEOF'
import sys, yaml
site_key, secret_key = sys.argv[1], sys.argv[2]
path = '$DATA_DIR/config.yml'
with open(path) as f:
    conf = yaml.safe_load(f)
conf['RAVEN_TURNSTILE_ENABLE'] = True
conf['RAVEN_TURNSTILE_SITE_KEY'] = site_key
conf['RAVEN_TURNSTILE_SECRET_KEY'] = secret_key
with open(path, 'w') as f:
    yaml.safe_dump(conf, f)
PYEOF"
      echo "Turnstile configured."
    fi
    # Don't leave the secret sitting in the debconf database.
    db_reset c4raven-server/turnstile-secret-key || true

    db_get c4raven-server/domain
    DOMAIN="$RET"

    # -------------------------------------------------------------------
    # Certificate authority
    # -------------------------------------------------------------------
    echo "Creating the certificate authority..."
    raven_exec "flask raven create-ca"
    # Unlike create-ca, issue-server-certificate is NOT idempotent -- it
    # unconditionally wipes and regenerates certs/raven/ if it already
    # exists (CertificateAuthority.issue_certificate() does an
    # unconditional shutil.rmtree). install.sh gets away with calling it
    # unguarded because it only ever runs once per install; this postinst
    # runs on every upgrade too, so it needs its own guard to avoid
    # silently reissuing (and invalidating) the server's TLS cert on
    # every `apt upgrade`.
    if [ ! -f "$DATA_DIR/ca/certs/raven/raven.pem" ]; then
      raven_exec "flask raven issue-server-certificate"
    fi

    # -------------------------------------------------------------------
    # mediamtx
    # -------------------------------------------------------------------
    echo "Installing mediamtx..."
    run_as_app "mkdir -p '$DATA_DIR/mediamtx/recordings'"
    # mediamtx publishes one release tarball per CPU architecture
    # (mediamtx_v<ver>_linux_{amd64,arm64,armv6,armv7}.tar.gz) -- both the
    # offline payload and the online download have to pick the right one.
    # The old `*) MTX_ARCH=armv7` catch-all silently fetched a 32-bit ARM
    # binary for anything that wasn't x86_64/aarch64 (riscv64, ppc64el, s390x),
    # which installs fine and then dies with "Exec format error" at first
    # boot; fail here with a readable message instead.
    #
    # Keyed on the dpkg architecture, NOT `uname -m`: inside a maintainer
    # script dpkg's answer is the authoritative one and uname's is not. A
    # 32-bit armhf userland on a 64-bit kernel (the common Raspberry Pi OS
    # layout) reports `aarch64`, which would pick the arm64 build -- an
    # unrunnable binary online, and offline a spurious "wrong bundle for this
    # architecture" abort on a correctly matched armhf bundle. Using dpkg's
    # names also makes this map character-for-character the same as the one
    # in build-deb.sh, which reads them out of the payload MANIFEST.
    DPKG_ARCH=$(dpkg --print-architecture)
    case "$DPKG_ARCH" in
      amd64) MTX_ARCH=amd64 ;;
      arm64) MTX_ARCH=arm64 ;;
      armhf) MTX_ARCH=armv7 ;;
      armel) MTX_ARCH=armv6 ;;
      *)
        echo "mediamtx publishes no Linux build for $DPKG_ARCH -- video streaming" >&2
        echo "cannot be installed on this architecture." >&2
        exit 1
        ;;
    esac
    if offline; then
      # Always re-extract: a newer package may bundle a newer mediamtx.
      #
      # The payload only carries its own architecture's tarball, and the
      # offline .deb is Architecture: amd64/arm64 for exactly that reason,
      # so dpkg already refuses the wrong one. Check anyway: with
      # --force-architecture the glob would stay unexpanded and tar would
      # fail on a filename with a literal '*' in it.
      shopt -s nullglob
      MTX_TARBALLS=("$OFFLINE_DIR"/mediamtx/mediamtx_*_linux_"$MTX_ARCH".tar.gz)
      shopt -u nullglob
      if [ ${#MTX_TARBALLS[@]} -eq 0 ]; then
        echo "This package bundles mediamtx for: $(cd "$OFFLINE_DIR/mediamtx" && ls mediamtx_*_linux_*.tar.gz | sed 's/.*_linux_//;s/\.tar\.gz//' | tr '\n' ' ')" >&2
        echo "but this system is $DPKG_ARCH ($MTX_ARCH). Use the offline bundle built for this architecture." >&2
        exit 1
      fi
      run_as_app "tar -xzf '${MTX_TARBALLS[0]}' -C '$DATA_DIR/mediamtx' mediamtx LICENSE"
    elif [ ! -f "$DATA_DIR/mediamtx/mediamtx" ]; then
      # lastversion is one of the backend's own dependencies, so it's in the
      # Poetry venv already; run it from there (`poetry run` needs the cwd).
      run_as_app "cd '$APP_HOME/c4raven-server' && poetry run lastversion --filter '~*linux_$MTX_ARCH' --only 1.13.0 -o '$DATA_DIR/mediamtx/mediamtx.tar.gz' --assets download bluenviron/mediamtx"
      run_as_app "cd '$DATA_DIR/mediamtx' && tar -xf mediamtx.tar.gz && rm -f mediamtx.tar.gz"
    fi
    # Cert/data paths were substituted at package-build time (build-deb.sh
    # runs install.sh's sed over the same templates; APP_HOME/DATA_DIR are
    # constants). Only the public host for WebRTC is machine-specific.
    install -o "$APP_USER" -g "$APP_USER" -m 644 "$PKGDATA/mediamtx.yml" "$DATA_DIR/mediamtx/mediamtx.yml"
    sed -i "s~^webrtcAdditionalHosts: \[\]~webrtcAdditionalHosts: [${DOMAIN:-$(hostname -I | awk '{print $1}')}]~" \
      "$DATA_DIR/mediamtx/mediamtx.yml"

    # -------------------------------------------------------------------
    # nginx
    # -------------------------------------------------------------------
    echo "Configuring nginx..."
    if ! grep -q "stream {" /etc/nginx/nginx.conf; then
      echo "
stream {
        include /etc/nginx/streams-enabled/*;
}" >> /etc/nginx/nginx.conf
    fi

    mkdir -p /etc/nginx/streams-available /etc/nginx/streams-enabled

    # On upgrade, don't overwrite a site file certbot has already rewritten
    # (LE cert paths, redirects) -- that would put the server back on the
    # self-signed cert until certbot's re-run below succeeds, and lose any
    # local edits for good. Fresh files and untouched ones are replaced.
    for f in raven_http raven_https raven_certificate_enrollment; do
      dst="/etc/nginx/sites-available/$f"
      if [ -f "$dst" ] && grep -q "managed by Certbot" "$dst"; then
        echo "Leaving $dst alone (modified by certbot); new template is at $PKGDATA/nginx_configs/$f"
      else
        install -m 644 "$PKGDATA/nginx_configs/$f" "$dst"
      fi
    done
    for f in rabbitmq mediamtx; do
      install -m 644 "$PKGDATA/nginx_configs/$f" "/etc/nginx/streams-available/$f"
    done

    # Only touch our own site files -- don't blow away unrelated
    # sites-enabled entries an admin may have added by hand (install.sh
    # does `rm -f sites-enabled/*`, which is fine for a from-scratch
    # install but too heavy-handed for a package upgrade).
    ln -sf /etc/nginx/sites-available/raven_http /etc/nginx/sites-enabled/raven_http
    ln -sf /etc/nginx/sites-available/raven_https /etc/nginx/sites-enabled/raven_https
    ln -sf /etc/nginx/sites-available/raven_certificate_enrollment /etc/nginx/sites-enabled/raven_certificate_enrollment
    ln -sf /etc/nginx/streams-available/rabbitmq /etc/nginx/streams-enabled/rabbitmq
    ln -sf /etc/nginx/streams-available/mediamtx /etc/nginx/streams-enabled/mediamtx

    # Owned by the app user, not world-writable: any local account could
    # otherwise swap out the served JavaScript.
    install -d -o "$APP_USER" -g "$APP_USER" -m 755 "$WEBROOT"

    # -------------------------------------------------------------------
    # Firewall
    #
    # The same port list, through the same shim, as install.sh and
    # rpm/configure.sh. All three install paths have to agree: the .deb
    # used to open nothing, so on an Ubuntu box whose admin had enabled
    # ufw it came up green in the web UI with every EUD and media port
    # shut and no ATAK client able to connect.
    #
    # This is not as invasive as it reads. firewall_open() is a no-op
    # unless a firewall is actually RUNNING -- Ubuntu ships ufw installed
    # but inactive, so the ordinary install changes nothing -- it only
    # ever ADDS allow rules, and it never enables a firewall that is off.
    #
    # Sourced in a SUBSHELL deliberately: lib/distro.sh defines its own
    # node_ok(), which sourced at this scope would silently replace the
    # Node-version check above. firewall_open only runs external commands,
    # so it loses nothing by running in a subshell.
    #
    # Failure here warns rather than aborts: leaving the package
    # half-configured is worse than leaving a port shut, and the message
    # tells the admin exactly what to run.
    # -------------------------------------------------------------------
    # nginx: web UI (80/443), the insecure Marti listener (8080), the
    # client-cert-verified Marti listener (8443), certificate enrollment
    # (8446), and the TLS stream proxies (RTSPS 8322, RTMPS 1936, MQTTS
    # 8883). Then mediamtx's own plaintext ingest and media paths (RTSP
    # 8554, RTMP 1935, WebRTC ICE 8189/udp, SRT 8890/udp) -- its HLS
    # (8888) and WebRTC HTTP (8889) stay shut, nginx only reaches those on
    # 127.0.0.1. Finally the EUD ports: eud_handler/eud_handler_ssl bind
    # 8087/udp, 8088/tcp and 8089/tcp directly rather than through nginx,
    # so they are invisible if you derive this list from nginx_configs/.
    RAVEN_PORTS=(80/tcp 443/tcp 8080/tcp 8443/tcp 8446/tcp 8322/tcp 1936/tcp 8883/tcp
                 8554/tcp 1935/tcp 8189/udp 8890/udp
                 8088/tcp 8089/tcp 8087/udp)
    OPEN_FW="${RAVEN_OPEN_FIREWALL:-true}"
    if [ "${OPEN_FW,,}" != "true" ]; then
      echo "RAVEN_OPEN_FIREWALL=$OPEN_FW -- leaving the firewall alone."
    elif [ -r "$PKGDATA/lib/distro.sh" ]; then
      echo "Opening firewall ports (no effect unless a firewall is running)..."
      # shellcheck source=/dev/null
      if ! ( . "$PKGDATA/lib/distro.sh" && firewall_open "${RAVEN_PORTS[@]}" ); then
        echo "warning: opening the firewall ports failed. If this host runs ufw or" >&2
        echo "         firewalld, run: for p in ${RAVEN_PORTS[*]}; do sudo ufw allow \$p; done" >&2
      fi
    else
      echo "warning: $PKGDATA/lib/distro.sh is missing, so no firewall ports were" >&2
      echo "         opened. If this host runs ufw or firewalld, run:" >&2
      echo "         for p in ${RAVEN_PORTS[*]}; do sudo ufw allow \$p; done" >&2
    fi

    systemctl enable nginx
    systemctl restart nginx

    if [ -n "$DOMAIN" ]; then
      # Take the 8446 domain block (written below on a previous configure)
      # out of nginx's sight first: it has `server_name $DOMAIN`, and certbot
      # installs into the FIRST ssl block whose server_name matches -- that
      # one -- so the web UI on 443 would never get its own LE block.
      rm -f /etc/nginx/sites-enabled/raven_certificate_enrollment_domain \
            /etc/nginx/sites-available/raven_certificate_enrollment_domain
      echo "Requesting a Let's Encrypt certificate for ${DOMAIN}..."
      certbot --nginx -d "$DOMAIN" --non-interactive --agree-tos -m "admin@${DOMAIN}" --redirect || \
        echo "certbot failed -- check that ${DOMAIN} already resolves to this server's public IP, then run: sudo certbot --nginx -d ${DOMAIN}"

      # Port 8446 for domain users (ATAK Quick Connect): a `server_name
      # $DOMAIN` block with the LE certificate, beside raven_certificate_
      # enrollment's default block that keeps Raven's own cert for VPN/bare-IP
      # users. Only once a certificate exists -- a block pointing at a missing
      # file stops nginx loading at all; one from an earlier run counts.
      # Always re-rendered (never certbot-modified: certbot cannot see it).
      # KEEP IN STEP with install.sh and rpm/configure.sh.
      if [ -f "/etc/letsencrypt/live/$DOMAIN/fullchain.pem" ]; then
        sed "s~DOMAIN_NAME~$DOMAIN~g" "$PKGDATA/nginx_configs/raven_certificate_enrollment_domain" \
          > /etc/nginx/sites-available/raven_certificate_enrollment_domain
        chmod 644 /etc/nginx/sites-available/raven_certificate_enrollment_domain
        ln -sf /etc/nginx/sites-available/raven_certificate_enrollment_domain \
               /etc/nginx/sites-enabled/raven_certificate_enrollment_domain
        # Renewal repoints the live/ symlinks; nginx only reads them on
        # (re)load. certbot's nginx installer already reloads after a renewal,
        # but this block is not one certbot manages, so don't depend on that.
        install -d -m 755 /etc/letsencrypt/renewal-hooks/deploy
        printf '#!/bin/sh\n# c4raven-server: reload nginx so port 8446 serves the renewed certificate.\nsystemctl reload nginx\n' \
          > /etc/letsencrypt/renewal-hooks/deploy/raven-nginx-reload
        chmod 755 /etc/letsencrypt/renewal-hooks/deploy/raven-nginx-reload
        if nginx -t >/dev/null 2>&1; then
          systemctl reload nginx
        else
          echo "nginx rejected the port-8446 domain block; removed it again. Domain users on 8446 will get Raven's own certificate." >&2
          rm -f /etc/nginx/sites-enabled/raven_certificate_enrollment_domain \
                /etc/nginx/sites-available/raven_certificate_enrollment_domain
          systemctl reload nginx || true
        fi
      else
        echo "No Let's Encrypt certificate for ${DOMAIN} yet, so port 8446 serves only Raven's own certificate (VPN/IP onboarding works; domain Quick Connect does not). Run 'sudo dpkg-reconfigure c4raven-server' once certbot succeeds."
      fi
    fi

    # -------------------------------------------------------------------
    # Frontend
    # -------------------------------------------------------------------
    if offline; then
      echo "Deploying the bundled C4 Raven UI frontend..."
      install -d -o "$APP_USER" -g "$APP_USER" -m 755 "$WEBROOT"
      rsync -a --no-perms --no-owner --no-group --omit-dir-times --delete "$OFFLINE_DIR/ui/" "$WEBROOT/"
      chown -R "$APP_USER:$APP_USER" "$WEBROOT"
    else
    echo "Building and deploying the C4 Raven UI frontend..."
    if [ ! -d "$APP_HOME/c4raven-ui" ]; then
      run_as_app "git clone https://github.com/C4-Raven/c4raven-ui.git '$APP_HOME/c4raven-ui'"
    fi
    if [ -f "$PKGDATA/UI_SHA" ]; then
      UI_SHA=$(cat "$PKGDATA/UI_SHA")
      # src/_versions.ts is a build stamp `yarn build` rewrites; discard it
      # first or git refuses to switch commits.
      run_as_app "cd '$APP_HOME/c4raven-ui' && git checkout -- src/_versions.ts 2>/dev/null; git fetch origin && git checkout '$UI_SHA'"
    fi
    # The UI build (vite 8) needs Node 20.19+ / 22.12+. Depends: says
    # nodejs (>= 20.19), but check the binary too, and make sure corepack
    # is there (it runs the yarn 4 version c4raven-ui pins; NodeSource's
    # nodejs ships it, a distro node may not).
    if ! node_ok; then
      echo "Node.js 20.19+ is required to build the UI but $(node --version 2>/dev/null || echo 'no node') is installed." >&2
      echo "Install Node 22 from https://deb.nodesource.com (setup_22.x) and re-run: sudo dpkg --configure -a" >&2
      exit 1
    fi
    command -v corepack >/dev/null 2>&1 || npm install -g corepack
    # c4raven-ui pins yarn 4 (packageManager in package.json) -- npm
    # doesn't understand its lockfile and will silently downgrade/corrupt
    # it. `corepack yarn` runs the pinned version directly.
    run_as_app "cd '$APP_HOME/c4raven-ui' && COREPACK_ENABLE_DOWNLOAD_PROMPT=0 corepack yarn install --immutable"
    run_as_app "cd '$APP_HOME/c4raven-ui' && corepack yarn build"
    # Deploy as root: whatever previously owned files are in the webroot
    # might not be deletable by $APP_USER even though the directory is
    # world-writable (confirmed live against a server whose webroot had
    # www-data-owned files). Root can always write/delete here regardless
    # of prior ownership.
    rsync -a --no-perms --no-owner --no-group --omit-dir-times --delete "$APP_HOME/c4raven-ui/dist/" "$WEBROOT/"
    chown -R "$APP_USER:$APP_USER" "$WEBROOT"
    fi

    # -------------------------------------------------------------------
    # RabbitMQ (before the Raven services start: they connect to it on boot)
    # -------------------------------------------------------------------
    echo "Configuring RabbitMQ..."
    # Plugins first: RabbitMQ refuses to start on mqtt.*/auth_http.* settings
    # whose plugins aren't enabled yet.
    rabbitmq-plugins enable --offline rabbitmq_mqtt rabbitmq_auth_backend_http
    install -m 644 "$PKGDATA/rabbitmq.conf" /etc/rabbitmq/rabbitmq.conf

    RABBITMQ_VERSION=$(rabbitmqadmin --version 2>/dev/null | awk '{print $2}' || true)
    if [ -n "$RABBITMQ_VERSION" ] && ! grep -q PLUGINS_DIR /etc/rabbitmq/rabbitmq-env.conf 2>/dev/null; then
      echo "PLUGINS_DIR=\"/usr/lib/rabbitmq/plugins:/usr/lib/rabbitmq/lib/rabbitmq_server-${RABBITMQ_VERSION}/plugins\"" >> /etc/rabbitmq/rabbitmq-env.conf
    fi
    systemctl restart rabbitmq-server

    # -------------------------------------------------------------------
    # Secrets env file + systemd units (units themselves already shipped
    # statically by the package at /lib/systemd/system/ -- nothing to
    # template, just enable/start them)
    # -------------------------------------------------------------------
    echo "Starting services..."
    if [ ! -f "$APP_HOME/.raven-secrets.env" ]; then
      cat > "$APP_HOME/.raven-secrets.env" << EOF
RAVEN_DATA_FOLDER=$DATA_DIR
SQLALCHEMY_DATABASE_URI=$DB_URI
RAVEN_RABBITMQ_USERNAME=guest
RAVEN_RABBITMQ_PASSWORD=guest
RAVEN_FEDHUB_ENABLE=False
RAVEN_MEDIAMTX_ENABLE=True
EOF
      chown "$APP_USER:$APP_USER" "$APP_HOME/.raven-secrets.env"
      chmod 600 "$APP_HOME/.raven-secrets.env"
    fi

    systemctl daemon-reload
    systemctl enable mediamtx raven cot_parser eud_handler eud_handler_ssl
    systemctl restart mediamtx raven cot_parser eud_handler eud_handler_ssl

    # The database schema is created by the migrations the server runs on
    # startup, so wait for it to answer before anything touches the database.
    echo "Waiting for the Raven server to come up..."
    RAVEN_UP=""
    for i in $(seq 1 60); do
      if curl -fsS -o /dev/null http://127.0.0.1:8081/api/health 2>/dev/null; then RAVEN_UP=1; break; fi
      if [ "$i" -eq 60 ]; then
        echo "raven did not answer on 127.0.0.1:8081 after 2 minutes -- check $DATA_DIR/logs/raven.log"
      fi
      sleep 2
    done

    # -------------------------------------------------------------------
    # Federation Hub -- requires a licensed TAK.gov account, so this can't
    # be prompted for or downloaded automatically. Point to the manual
    # follow-up instead of trying to collect a file path via debconf.
    # -------------------------------------------------------------------
    echo
    echo "Federation Hub requires a takserver-fed-hub_*.deb package, only"
    echo "available from a licensed TAK.gov account -- this package can't"
    echo "include it. See https://github.com/C4-Raven/federation-hub-setup"
    echo "if you have one and want to install it."

    # -------------------------------------------------------------------
    # First admin account. The server creates `administrator`/`password`
    # itself on first start; seed_admin.py makes that account change its
    # password on first login (or creates it that way if it doesn't exist
    # yet). Exit 3 = real accounts already exist, nothing touched.
    # -------------------------------------------------------------------
    echo "Hardening the first administrator account..."
    SEEDED=0
    raven_exec "python '$PKGDATA/seed_admin.py'" || SEEDED=$?

    # -------------------------------------------------------------------
    # Bundled ATAK plugin(s) (offline build): publish into the package repo
    # so enrolling devices are offered them. Never downgrades a newer APK
    # someone already uploaded; exit 3 = already published.
    # -------------------------------------------------------------------
    if offline; then
      for apk in "$OFFLINE_DIR"/plugins/*.apk; do
        [ -f "$apk" ] || continue
        echo "Publishing $(basename "$apk") to the ATAK package repository..."
        PUBLISHED=0
        raven_exec "python '$PKGDATA/seed_plugin.py' '$apk'" || PUBLISHED=$?
        case "$PUBLISHED" in
          0|3) ;;
          *) echo "Could not publish $(basename "$apk") (seed_plugin.py exit $PUBLISHED). Once raven is running: sudo -u $APP_USER -H bash -lc \"cd $DATA_DIR && $FLASK_ENV $APP_HOME/venv/bin/python $PKGDATA/seed_plugin.py $apk\"" ;;
        esac
      done

      # The new services are running from the new venv; drop older ones --
      # but only once raven has answered, so a broken upgrade can still be
      # rolled back by repointing the symlink.
      CURRENT_VENV=$(readlink -f "$APP_HOME/venv")
      if [ -n "$RAVEN_UP" ]; then
        for d in "$APP_HOME"/venvs/*; do
          if [ -d "$d" ] && [ "$(readlink -f "$d")" != "$CURRENT_VENV" ]; then
            rm -rf "$d"
          fi
        done
      else
        echo "Kept the previous venvs in $APP_HOME/venvs because raven did not come up."
        echo "To roll back: ln -sfn $APP_HOME/venvs/<previous> $APP_HOME/venv && systemctl restart raven cot_parser eud_handler eud_handler_ssl"
      fi
    fi

    echo
    echo "Setup complete."
    if [ -n "$DOMAIN" ]; then
      echo "Web UI: https://${DOMAIN}"
    else
      echo "Web UI: https://$(hostname -I | awk '{print $1}')"
    fi
    case "$SEEDED" in
      0) echo "First login: username 'administrator', password 'password' -- you'll be required to set a real password immediately." ;;
      3) echo "Existing accounts were left untouched -- log in with your usual administrator credentials." ;;
      *)
        if offline; then
          echo "Could not verify the administrator account (seed_admin.py exit $SEEDED). Once raven is running: sudo -u $APP_USER -H bash -lc \"cd $DATA_DIR && $FLASK_ENV $APP_HOME/venv/bin/python $PKGDATA/seed_admin.py\""
        else
          echo "Could not verify the administrator account (seed_admin.py exit $SEEDED). Once raven is running: sudo -u $APP_USER -H bash -lc \"cd $APP_HOME/c4raven-server && $FLASK_ENV poetry run python $PKGDATA/seed_admin.py\""
        fi
        ;;
    esac
    ;;

  abort-upgrade|abort-remove|abort-deconfigure)
    ;;
esac

db_stop

exit 0
