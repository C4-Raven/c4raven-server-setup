#!/bin/sh
# Debconf prompt script -- runs before postinst, collects the same
# interactive answers install.sh used to ask with `read`/`ask_yn`.
set -e

. /usr/share/debconf/confmodule

db_input high c4raven-server/domain || true
db_go

db_input high c4raven-server/turnstile-enable || true
db_go

db_get c4raven-server/turnstile-enable
if [ "$RET" = "true" ]; then
  db_input high c4raven-server/turnstile-site-key || true
  db_go
  db_input high c4raven-server/turnstile-secret-key || true
  db_go
fi

exit 0
