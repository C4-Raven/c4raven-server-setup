# Proxy RTSPS and RTMPS through nginx because MediaMTX doesn't have permissions to read Let's Encrypt certs files

# RTSP
server {
    listen     8322 ssl;
    proxy_pass 127.0.0.1:8554;

    ssl_certificate /opt/raven/data/ca/certs/raven/raven.pem;
    ssl_certificate_key /opt/raven/data/ca/certs/raven/raven.nopass.key;
}

# RTMP
server {
    listen     1936 ssl;
    proxy_pass 127.0.0.1:1935;

    ssl_certificate /opt/raven/data/ca/certs/raven/raven.pem;
    ssl_certificate_key /opt/raven/data/ca/certs/raven/raven.nopass.key;
}
