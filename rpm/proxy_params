# /etc/nginx/proxy_params
#
# Debian's nginx package ships this file; Enterprise Linux's does not. Both
# nginx_configs/raven_http and nginx_configs/raven_https do
# `include proxy_params;` inside their /socket.io block, and nginx refuses to
# load its whole configuration if the include is missing -- so the RPM ships a
# byte-identical copy of Debian's and installs it only when /etc/nginx has none.
proxy_set_header Host $http_host;
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $scheme;
