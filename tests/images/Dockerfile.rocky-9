# Rocky Linux 9 with a real systemd as PID 1.
#
# quay.io/rockylinux/rockylinux:9-ubi-init is Rocky's own systemd-enabled
# image (the `-init` suffix means PID 1 is /sbin/init). Verified multi-arch:
# the 9-ubi-init manifest list carries linux/amd64 and linux/arm64, so the
# same Dockerfile builds both.
#
# As with the Ubuntu image, nothing the installer is meant to install is
# pre-installed -- in particular NOT epel-release and NOT the PGDG repo.
# Whether lib/distro.sh wires those up correctly is the thing under test.
FROM quay.io/rockylinux/rockylinux:9-ubi-init

ENV container=docker \
    LANG=C.UTF-8

# ubi-init ships microdnf on some builds and full dnf on others; normalise.
#
# No `curl` in this list: the base image ships curl-minimal, which
# Provides: curl but Conflicts: curl, and `dnf install curl` asks for the
# package *named* curl, so it fails without --allowerasing. curl-minimal
# already gives /usr/bin/curl with http/https, which is all the harness and
# install.sh need -- and it is what many real EL9 boxes have, so keep it.
RUN (command -v dnf >/dev/null 2>&1 || microdnf -y install dnf) \
 && dnf -y install --setopt=install_weak_deps=False \
      sudo shadow-utils util-linux procps-ng iproute hostname \
      ca-certificates \
 && command -v curl >/dev/null \
 && dnf clean all

RUN systemctl mask \
      systemd-udevd.service systemd-udev-trigger.service \
      systemd-udevd-kernel.socket systemd-udevd-control.socket \
      systemd-modules-load.service \
      systemd-journald-audit.socket \
      sys-kernel-config.mount sys-kernel-debug.mount sys-kernel-tracing.mount \
      getty.target console-getty.service getty@tty1.service \
      systemd-firstboot.service \
 || true

# !pam_acct_mgmt: on an Ubuntu 24.04 host (GitHub's runners included) the
# host's AppArmor profile for unix_chkpwd attaches by path to this image's
# /usr/sbin/unix_chkpwd too, because --privileged leaves the container
# unconfined. It denies dac_override/dac_read_search, EL's /etc/shadow is mode
# 0000, so pam_unix's account check for tester fails and every `sudo` dies
# with "PAM account management error: Authentication service cannot retrieve
# authentication info" (journal: apparmor="DENIED" profile="unix-chkpwd").
# Ubuntu's 0640 root:shadow layout never needs those caps, so only this image
# is affected. Skipping account management for the harness's own throwaway
# user changes nothing the installer does.
RUN useradd --create-home --shell /bin/bash tester \
 && printf 'Defaults:tester !pam_acct_mgmt\ntester ALL=(ALL) NOPASSWD:ALL\n' > /etc/sudoers.d/90-tester \
 && chmod 0440 /etc/sudoers.d/90-tester \
 && visudo -cf /etc/sudoers.d/90-tester \
 && runuser -u tester -- sudo -n true

STOPSIGNAL SIGRTMIN+3

CMD ["/sbin/init"]
